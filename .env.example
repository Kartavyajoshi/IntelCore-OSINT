# ============================================
# IntelCore OSINT Platform — Environment Config
# ============================================
# Copy this file to .env and fill in your API keys.
# All keys are optional — free scans work without them.

# Shodan (https://account.shodan.io/) — internet device search
SHODAN_API_KEY=

# VirusTotal (https://www.virustotal.com/gui/my-apikey) — malware & URL scanning
VT_API_KEY=

# Have I Been Pwned (https://haveibeenpwned.com/API/Key) — breach checking
HIBP_API_KEY=

# LeakCheck (https://leakcheck.io/) — credential leak search
LEAKCHECK_API_KEY=

# DeHashed (https://dehashed.com/) — breach database search
DEHASHED_API_KEY=

# Database Configuration (optional — defaults to SQLite)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=osint_db
DB_USER=
DB_PASSWORD=

# Application
ENV=development
DEBUG=False
